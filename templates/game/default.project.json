{
	"name": "cluaupp-game",
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$path": "out/Server",
			"Parallel": {
				"$path": "out/Parallel"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Declarations": {
				"$path": "out/Declarations"
			},
			"Include": {
				"$path": "out/Include"
			},
			"Modules": {
				"$path": "out/Modules"
			},
			"CluauppLibs": {
				"$path": "libs"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$path": "out/Client"
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		}
	}
}

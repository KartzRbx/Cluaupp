{
	"name": "cluaupp",
	"version": "0.1.0",
	"description": "Cluaupp — the definitive merge of C++ and modern Luau. Source-to-source transpiler with first-class Roblox APIs.",
	"author": "KartzDev",
	"license": "MIT",
	"bin": {
		"cluaupp": "bin/cluaupp.js",
		"cluau": "bin/cluaupp.js"
	},
	"main": "src/compile.js",
	"exports": {
		".": "./src/compile.js",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"src",
		"include",
		"templates",
		"runtime",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"docs"
	],
	"scripts": {
		"cluaupp": "node bin/cluaupp.js",
		"cluau": "node bin/cluaupp.js",
		"build": "node bin/cluaupp.js build",
		"watch": "node bin/cluaupp.js watch",
		"test": "node test/leaderstats.test.js && node test/understand.test.js && node test/datatypes.test.js && node test/headers.test.js && node test/libs.test.js && node test/runtime-libs.test.js",
		"generate-api": "node scripts/generate-api.js",
		"vendor-libs": "node scripts/vendor-libs.js",
		"docs": "moonwave dev",
		"docs:build": "moonwave build",
		"prepublishOnly": "npm test"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"luau",
		"roblox",
		"cpp",
		"c++",
		"transpiler",
		"compiler",
		"rojo",
		"cluaupp",
		"cluau"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kartzDev/cluaupp.git"
	},
	"bugs": {
		"url": "https://github.com/kartzDev/cluaupp/issues"
	},
	"homepage": "https://github.com/kartzDev/cluaupp#readme"
}

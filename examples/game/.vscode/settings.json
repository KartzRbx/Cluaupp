{
	"clangd.enable": true,
	"clangd.arguments": [
		"--compile-commands-dir=${workspaceFolder}",
		"--header-insertion=never",
		"--query-driver=**/clang++*,**/clang++.exe,**/g++*,**/g++.exe"
	],
	"files.associations": {
		"*.hpp": "cpp",
		"*.h": "cpp",
		"*.server.cpp": "cpp",
		"*.client.cpp": "cpp",
		"*.plugin.cpp": "cpp",
		"*.legacy.cpp": "cpp",
		"*.legacy.server.cpp": "cpp",
		"*.legacy.client.cpp": "cpp"
	}
}
